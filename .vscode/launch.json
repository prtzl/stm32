// Configure debug launch settings
{
    "version": "0.2.0",
    "projectName": "test-f407vg",
    "configurations": [
        {
            "name": "JLink launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/firmware-debug-1.0.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "serverpath": "JLinkGDBServerCLExe",
            "device": "STM32F407VG",
            "interface": "swd",
            "runToEntryPoint": "main",
            "swoConfig":
            {
                "enabled": true,
                "cpuFrequency": 160000000,
                "swoFrequency": 4000000,
                "source": "probe",
                "decoders":
                [
                    {
                        "label": "ITM port 0 output",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ]
            }
        },
        {
            "name": "JLink attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/firmware-debug-1.0.elf",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "jlink",
            "serverpath": "JLinkGDBServerCLExe",
            "device": "STM32F407VG",
            "interface": "swd",
            "swoConfig":
            {
                "enabled": true,
                "cpuFrequency": 160000000,
                "swoFrequency": 4000000,
                "source": "probe",
                "decoders":
                [
                    {
                        "label": "ITM port 0 output",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ]
            }
        }
    ]
}
